# SMAA frontend environment
# Copy to .env (Vite reads .env from this repo root) and restart the dev server —
# these values are baked into the client and SSR bundles at build time.

# Base URL of the SMAA backend API. Without it, apiConfigured === false and every
# call throws ApiError 503 API_NOT_CONFIGURED before any network request is made.
# No trailing slash (one is stripped anyway). Not a secret.
VITE_API_BASE_URL=https://api.42studio.fit
